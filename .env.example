# -------------------------------------------------------
# .env.example — Sao chép thành .env và điền giá trị thật
# -------------------------------------------------------

# App
APP_ENV=production
LOG_LEVEL=INFO

# Database (Sử dụng SQLite cho server cục bộ không có Docker)
DATABASE_URL=sqlite:///./local_database.db

# AI Models
# Kết nối tới Ollama API có sẵn của server
OLLAMA_API_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_NAME=qwen2.5:7b-instruct
PHOWHISPER_MODEL=vinai/PhoWhisper-medium

# Audio
AUDIO_DOWNLOAD_DIR=./data
MAX_AUDIO_SIZE_MB=500
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,ogg

# Webhook URLs — CRM của đối tác
WEBHOOK_URL=
CRM_WEBHOOK_URL=
CRM_SALES_WEBHOOK_URL=
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF=1.0

# Zalo OA (nếu dùng)
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_ID=
