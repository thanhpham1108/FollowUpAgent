# -------------------------------------------------------
# .env.example — Sao chép thành .env và điền giá trị thật
# -------------------------------------------------------

# App
APP_ENV=production
LOG_LEVEL=INFO

# Database (PostgreSQL — async driver)
DATABASE_URL=postgresql+asyncpg://thanhpnc:password@localhost:5433followup_agent

# AI Models
# Kết nối tới Ollama API có sẵn của server
OLLAMA_API_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_NAME=qwen2.5:7b-instruct
PHOWHISPER_MODEL=vinai/PhoWhisper-medium

# Audio
AUDIO_DOWNLOAD_DIR=./data
MAX_AUDIO_SIZE_MB=500
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,ogg

# Webhook URLs — CRM của đối tác
WEBHOOK_URL=
CRM_WEBHOOK_URL=
CRM_SALES_WEBHOOK_URL=
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF=1.0

# Zalo OA (nếu dùng)
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_ID=

# ── Eval Pipeline (tests/eval/) ──────────────────────────────────────────────
# Model làm Giám khảo — phải KHÁC với OLLAMA_MODEL_NAME (Worker)
# Có thể dùng chung OLLAMA_API_BASE_URL nếu cùng server, hoặc chỉ định riêng
JUDGE_OLLAMA_BASE_URL=http://localhost:11434/v1
JUDGE_MODEL_NAME=llama3.1

# ── Load Testing (tests/load_test/) ──────────────────────────────────────────
# URL audio nội bộ nếu server test không ra được internet
# Để trống nếu server ra được internet (dùng URL public mặc định)
LOCUST_AUDIO_URL=
