# -------------------------------------------------------
# Environment Variables for FollowUpAgent
# Copy this file to .env and fill in your values
# -------------------------------------------------------

# === CRM Webhook ===
WEBHOOK_URL=http://192.168.1.200/webhook/candidate-recommendation

# === Local LLM Model ===
LLM_MODEL_PATH=/path/to/your/model.gguf

# === Audio Processing ===
AUDIO_DOWNLOAD_DIR=./data
MAX_AUDIO_SIZE_MB=500
ALLOWED_AUDIO_EXTENSIONS=.mp3,.wav,.m4a,.ogg

# === Webhook Retry ===
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF=1.0

# === Logging ===
LOG_LEVEL=INFO
