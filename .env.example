# -------------------------------------------------------
# .env.example — Sao chép thành .env và điền giá trị thật
# -------------------------------------------------------

# App
APP_ENV=production
LOG_LEVEL=INFO

# Database (trỏ vào container db nếu dùng Docker Compose)
DATABASE_URL=postgresql://postgres:password@db:5432/followup_agent

# AI Models
# Đặt file GGUF đã download vào thư mục /app/models/ trong server
LLM_MODEL_PATH=/app/models/your-model.gguf
LLM_GPU_LAYERS=-1
PHOWHISPER_MODEL=vinai/PhoWhisper-medium

# Audio
AUDIO_DOWNLOAD_DIR=./data
MAX_AUDIO_SIZE_MB=500
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,m4a,ogg

# Webhook URLs — CRM của đối tác
WEBHOOK_URL=
CRM_WEBHOOK_URL=
CRM_SALES_WEBHOOK_URL=
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF=1.0

# Zalo OA (nếu dùng)
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_ID=
